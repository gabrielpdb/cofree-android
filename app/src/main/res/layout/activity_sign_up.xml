<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary"

    tools:context=".activities.SignUp">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/slogan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:paddingHorizontal="40dp"
        android:text="Esse é o primeiro passo para o controle total da sua vida financeira."
        android:textAlignment="center"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"

        android:textStyle="normal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/slogan">

        <LinearLayout
            android:id="@+id/form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingBottom="360dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.example.cofree.ui.Input
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    app:hint="João"
                    app:label="Nome" />

                <com.example.cofree.ui.Input
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    app:hint="da Silva"
                    app:label="Sobrenome" />
            </LinearLayout>

            <com.example.cofree.ui.Input
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hint="01/01/2000"
                app:label="Data de nascimento" />

            <com.example.cofree.ui.Input
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hint="joaodasilva@cofree.com"
                app:label="Endereço de e-mail" />

            <com.example.cofree.ui.Input
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hint="************"
                app:label="Senha"
                app:showVisibility="true" />

            <com.example.cofree.ui.Input
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hint="************"
                app:label="Confirmação de senha"
                app:showVisibility="true" />


            <com.example.cofree.ui.TextButton
                android:id="@+id/button_cadastrar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:text="Cadastrar" />


        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/medium"
        android:orientation="vertical"
        android:paddingHorizontal="80dp"
        android:paddingVertical="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Já tem uma conta?"
            android:textAlignment="center"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <com.example.cofree.ui.TextButton
            android:id="@+id/button_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:text="Ir para login" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
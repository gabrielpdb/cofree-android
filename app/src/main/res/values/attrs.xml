        <attr name="label" format="string" />
        <attr name="hint" format="string" />
        <attr name="showVisibility" format="boolean" />
    </declare-styleable>

    <declare-styleable name="InputDate">
        <attr name="label" />
        <attr name="hint" />
    </declare-styleable>

    <declare-styleable name="InputSelect">
        <attr name="label" />
        <attr name="hint" />
        <attr name="rightInfo" format="string" />
    </declare-styleable>

    <declare-styleable name="InputTextArea">
        <attr name="label" />
        <attr name="hint" />
    </declare-styleable>

    <declare-styleable name="TextButton">
        <attr name="text" format="string" />
        <attr name="type" format="string" />
    </declare-styleable>
</resources>